+        outputs = []
+        start = 0
+        for count in partitions:
+            common = create_common_attn_metadata(
+                BatchSpec(seq_lens=[start + count + 1], query_lens=[count]),
+                BLOCK_SIZE,
+                device,
+                arange_block_indices=True,
