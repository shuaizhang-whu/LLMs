@@ -62,6 +62,25 @@ def log(msg):
     print(f"[{time.strftime('%H:%M:%S')}] {msg}", flush=True)
 
 
+def log_progress(config: str, completed: int, total: int, started_at: float) -> None:
+    """Print an in-place task progress bar with elapsed time and ETA."""
+    total = max(1, total)
+    completed = min(completed, total)
+    width = 28
+    filled = int(width * completed / total)
+    bar = "=" * filled + ">" + " " * max(0, width - filled - 1)
+    elapsed = max(0.0, time.time() - started_at)
+    rate = completed / elapsed if completed else 0.0
+    eta = (total - completed) / rate if rate else 0.0
+    print(
+        f"\r[{time.strftime('%H:%M:%S')}] {config:<8} [{bar}] "
+        f"{completed:>3}/{total:<3} ({completed / total:>6.1%}) "
+        f"elapsed={elapsed / 60:>5.1f}m ETA={eta / 60:>5.1f}m",
+        end="",
+        flush=True,
+    )
+
+
 def write_json(path: Path, obj):
     path.parent.mkdir(parents=True, exist_ok=True)
     path.write_text(json.dumps(obj, indent=2, ensure_ascii=False, default=str))
