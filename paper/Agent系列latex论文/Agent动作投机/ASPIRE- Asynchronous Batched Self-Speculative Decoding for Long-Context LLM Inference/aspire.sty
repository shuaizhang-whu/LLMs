%% aspire.sty -- house style for the ASPIRE arXiv version.
%% Single column, US Letter, XCharter text + newtx math at 11pt on a 6.5in
%% measure. Colors follow the paper's own palette (indigo accent, the
%% figure colors for the headline chart). Front matter: title, authors,
%% affiliation, page-one teaser figure, inline abstract, centered links row,
%% italic first-page note.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{aspire}[2026/09/11 ASPIRE arXiv style]

% ---------- page geometry ----------
\RequirePackage[letterpaper,left=1in,right=1in,top=1in,bottom=1in,
                headsep=0.2in,footskip=0.45in]{geometry}

% ---------- fonts ----------
\RequirePackage[T1]{fontenc}
\RequirePackage[scaled=.98,sups]{XCharter}
\RequirePackage[xcharter,vvarbb]{newtxmath}
\RequirePackage[scaled=.90]{inconsolata}
\RequirePackage{microtype}

% ---------- colors (paper palette) ----------
\RequirePackage[table]{xcolor}
\definecolor{accent}{HTML}{3F4693}     % indigo used across the ASPIRE figures/poster
\definecolor{aspviolet}{HTML}{7A63E8}  % ASPIRE bar color in the result figures
\definecolor{rulegray}{HTML}{9A9A9A}
\definecolor{darkblue}{rgb}{0,0,0.5}   % kept for compatibility with the camera-ready

% ---------- citations ----------
\RequirePackage{natbib}
\setcitestyle{authoryear,round,citesep={;},aysep={,},yysep={;}}
\setlength{\bibsep}{3pt plus 1pt}
\setlength{\bibhang}{1.2em}
\renewcommand{\bibfont}{\small}

% ---------- headings ----------
\RequirePackage{titlesec}
\titleformat{\section}{\large\bfseries\color{accent}}{\thesection}{0.7em}{}
\titleformat{\subsection}{\normalsize\bfseries}{\thesubsection}{0.7em}{}
\titleformat{\subsubsection}{\normalsize\bfseries\itshape}{\thesubsubsection}{0.7em}{}
\titleformat{\paragraph}[runin]{\bfseries}{}{0em}{}
\titlespacing*{\section}{0pt}{2.0ex plus .8ex minus .3ex}{1.0ex plus .3ex}
\titlespacing*{\subsection}{0pt}{1.6ex plus .5ex minus .2ex}{0.7ex plus .2ex}
\titlespacing*{\subsubsection}{0pt}{1.3ex plus .4ex minus .2ex}{0.5ex}
\titlespacing*{\paragraph}{0pt}{1.0ex plus .3ex}{0.6em}

% ---------- paragraphs ----------
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.55\baselineskip plus 2pt minus 1pt}
\widowpenalty=10000 \clubpenalty=10000

% ---------- captions / floats ----------
\RequirePackage[font=small,labelfont={bf,color=accent},labelsep=colon,skip=6pt]{caption}
\renewcommand{\topfraction}{0.95}
\renewcommand{\textfraction}{0.05}
\setlength{\floatsep}{10pt plus 2pt}
\setlength{\textfloatsep}{12pt plus 2pt}

% ---------- running header / footer ----------
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[C]{\footnotesize\itshape\color{rulegray}\@shorttitle}
\fancyfoot[C]{\small\thepage}
\renewcommand{\headrulewidth}{0pt}
\fancypagestyle{firstpage}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}\fancyfoot[C]{\small\thepage}}

% ---------- icons ----------
\RequirePackage{fontawesome5}

% ---------- front matter API ----------
\def\@shorttitle{}\def\@affiliation{}\def\@links{}\def\@firstpagenote{}\def\@teaser{}
\newcommand{\shorttitle}[1]{\gdef\@shorttitle{#1}}
\newcommand{\affiliation}[1]{\gdef\@affiliation{#1}}
\newcommand{\links}[1]{\gdef\@links{#1}}
\newcommand{\firstpagenote}[1]{\gdef\@firstpagenote{#1}}
\newcommand{\teaser}[1]{\gdef\@teaser{#1}}
\newcommand{\linkitem}[3]{{\color{accent}#1}\hspace{0.45em}\href{#2}{\texttt{#3}}}
\newcommand{\linksep}{\hspace{1.4em}{\color{rulegray}\vrule height 1.7ex depth 0.5ex width 0.5pt}\hspace{1.4em}}

\renewcommand{\maketitle}{%
  \thispagestyle{firstpage}%
  \begingroup
  \setlength{\parindent}{0pt}\setlength{\parskip}{0pt}%
  {\LARGE\bfseries\raggedright\@title\par}
  \vskip 1.1em
  {\normalsize\raggedright\@author\par}
  \vskip 0.5em
  {\small\raggedright\@affiliation\par}
  \vskip 0.8em
  {\color{accent}\rule{\textwidth}{1.4pt}}\par
  \ifx\@teaser\@empty\else\vskip 1.0em\@teaser\par\fi
  \endgroup
  \ifx\@firstpagenote\@empty\else
    \begingroup
    \renewcommand{\thefootnote}{}%
    \footnotetext{\hspace{-1.8em}\begin{minipage}{\textwidth}\footnotesize\itshape\@firstpagenote\end{minipage}}%
    \endgroup
  \fi
}

% ---------- abstract + links row ----------
\renewenvironment{abstract}%
  {\vskip 0.5em\par\noindent{\bfseries\color{accent}Abstract.}\ \ignorespaces}%
  {\par\ifx\@links\@empty\else\vskip 0.7em\centerline{\small\@links}\fi\vskip 0.4em}

\endinput
