}

% ============================================================
% MagicDec: speculative decoding scales to high-throughput regimes
% WHY: Overturns conventional wisdom that spec decoding only helps
% latency-bound (small batch) scenarios. Shows SD achieves speedup
% even at batch 32-256 for long contexts via sparse KV draft.
% Relevant to SPORK: proves speculation is viable in throughput-
% oriented serving (where tool-calling agents typically operate).
% ============================================================
@misc{sadhukhan_magicdec_2024,
	title = {{MagicDec}: Breaking the Latency-Throughput Tradeoff for Long Context Generation with Speculative Decoding},
	url = {http://arxiv.org/abs/2408.11049},
	doi = {10.48550/arXiv.2408.11049},
	abstract = {Large Language Models (LLMs) have become more prevalent in long-context applications such as interactive chatbots, document analysis, and agent workflows, but serving long-context requests with low latency and high throughput is challenging. In MagicDec, we show that surprisingly SD can achieve speedup even for a high throughput inference regime for moderate to long sequences. We demonstrate up to 2.51x speedup for Llama3.1-8B when serving batch sizes ranging from 32 to 256.},
	author = {Sadhukhan, Ranajoy and Chen, Jian and Chen, Zhuoming and Tiwari, Vashisth and Lai, Ruihang and Shi, Jinyuan and Yen, Ian En-Hsu and May, Avner and Chen, Tianqi and Chen, Beidi},
	date = {2024-08-20},
	year = {2024},
	eprinttype = {arxiv},
	eprint = {2408.11049 [cs]},
}

% ============================================================
% DistServe: disaggregated prefill/decode — foundational serving work
% WHY: Establishes the prefill-decode disaggregation paradigm that
% SPORK's architecture builds upon. Tool-calling agents amplify
% the prefill/decode asymmetry (repeated context loading on tool
% returns), making disaggregation even more critical.
% ============================================================
@misc{zhong_distserve_2024,
	title = {{DistServe}: Disaggregating Prefill and Decoding for Goodput-optimized Large Language Model Serving},
	url = {http://arxiv.org/abs/2401.09670},
	doi = {10.48550/arXiv.2401.09670},
	abstract = {DistServe improves the performance of large language models (LLMs) serving by disaggregating the prefill and decoding computation. Existing LLM serving systems colocate the two phases and batch the computation of prefill and decoding across all users and requests. We find that this strategy not only leads to strong prefill-decoding interferences but also couples the resource allocation and parallelism plans for both phases.},
	author = {Zhong, Yinmin and Liu, Shengyu and Chen, Junda and Hu, Jianbo and Zhu, Yibo and Liu, Xuanzhe and Jin, Xin and Zhang, Hao},
	date = {2024-01-17},
	year = {2024},
	eprinttype = {arxiv},
	eprint = {2401.09670 [cs]},
}

