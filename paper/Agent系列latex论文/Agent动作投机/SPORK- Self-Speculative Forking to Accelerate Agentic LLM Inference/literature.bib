% Certaindex / Dynasor: reasoning-aware LLM serving with early exit
% WHY: Builds a serving system around the idea that reasoning programs
% stabilize early. Certaindex metric detects when further compute
% won't change the answer → enables gang scheduling and dynamic
% token allocation. Directly relevant to SPORK: shows spec-style
% verify-and-commit logic integrated into serving schedulers.
% ============================================================
@misc{fu_certaindex_2024,
	title = {Efficiently Scaling {LLM} Reasoning with Certaindex},
	url = {http://arxiv.org/abs/2412.20993},
	doi = {10.48550/arXiv.2412.20993},
	abstract = {Test-time reasoning algorithms such as chain-of-thought, self-consistency, and MCTS enhance LLM problem-solving but can wastefully generate many tokens without improving accuracy. We introduce Certaindex, an algorithm-agnostic metric measuring evolving stability, signaling when further computation is unlikely to alter the final result. Built into Dynasor, our reasoning-aware LLM serving system, we demonstrate up to 50\% compute savings and 3.3x higher throughput with no accuracy drop.},
	author = {Fu, Yichao and Chen, Junda and Zhu, Siqi and Fu, Zheyu and Dai, Zhongdongming and Zhuang, Yonghao and Ma, Yian and Qiao, Aurick and Rosing, Tajana and Stoica, Ion and Zhang, Hao},
	date = {2024-12-30},
	year = {2024},
