% ============================================================
% Must-cite: early exit / speculative verification for reasoning
% WHY: Demonstrates that reasoning models encode "I'm done" signals
% in hidden states — 24% token reduction via probing-based early exit.
% Directly validates the SPORK premise: spec decoding principles
% (verify-then-commit) apply beyond token generation to reasoning steps.
% ============================================================
@misc{zhang_reasoning_2025,
	title = {Reasoning Models Know When They're Right: Probing Hidden States for Self-Verification},
	url = {http://arxiv.org/abs/2504.05419},
	doi = {10.48550/arXiv.2504.05419},
	abstract = {Reasoning models have achieved remarkable performance on tasks like math and logical reasoning thanks to their ability to search during reasoning. However, they still suffer from overthinking, often performing unnecessary reasoning steps even after reaching the correct answer. We study whether reasoning models encode information about answer correctness through probing the model's hidden states. The resulting probe can verify intermediate answers with high accuracy. We then use the probe as a verifier to decide whether to exit reasoning at intermediate answers during inference, reducing the number of inference tokens by 24\% without compromising performance.},
	author = {Zhang, Anqi and Chen, Yulin and Pan, Jane and Zhao, Chen and Panda, Aurojit and Li, Jinyang and He, He},
	date = {2025-04-07},
	year = {2025},
	eprinttype = {arxiv},
	eprint = {2504.05419 [cs]},
}

